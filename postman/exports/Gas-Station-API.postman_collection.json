          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shifts?role=CASHIER&date={{shift_date}}",
              "host": ["{{base_url}}"],
              "path": ["shifts"],
              "query": [
                {
                  "key": "role",
                  "value": "CASHIER"
                },
                {
                  "key": "date",
                  "value": "{{shift_date}}"
                }
