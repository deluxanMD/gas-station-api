                  "});",
                  "pm.test('each shift carries its owner name', () => {",
                  "  pm.response.json().data.forEach((shift) => pm.expect(shift.userName).to.be.a('string'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shifts?role=CASHIER",
              "host": ["{{base_url}}"],
              "path": ["shifts"],
              "query": [
                {
                  "key": "role",
                  "value": "CASHIER"
                }
              ]
            }
          }
        },
        {
          "name": "List shifts - by date",
