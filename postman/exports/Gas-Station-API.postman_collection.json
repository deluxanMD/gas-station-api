    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 on first run, 409 if the user already exists",
                  "pm.test('created or already exists', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "pm.test('returns the saved role on create', () => {",
                  "  if (pm.response.code !== 201) return;",
                  "  pm.expect(pm.response.json().data.userRole).to.eql(pm.collectionVariables.get('user_role'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"userRole\": \"{{user_role}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register - invalid role",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects unknown role with 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}-invalid-role\",\n  \"password\": \"{{password}}\",\n  \"confirmPassword\": \"{{password}}\",\n  \"userRole\": \"NOT_A_ROLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200 with userId', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.userId).to.eql(pm.collectionVariables.get('user_id'));",
                  "});",
                  "// Later requests use the numeric id as the shift owner.",
                  "pm.collectionVariables.set('db_user_id', String(pm.response.json().data.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login - invalid password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('rejects with 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Shifts",
      "item": [
        {
          "name": "Start shift",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 201 when a shift is opened, 200 when the user already had one open",
                  "pm.test('opens or returns the open shift', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "const shift = pm.response.json().data;",
                  "pm.test('shift is open', () => pm.expect(shift.endTime).to.eql(null));",
                  "pm.collectionVariables.set('shift_id', String(shift.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/shifts",
              "host": ["{{base_url}}"],
              "path": ["shifts"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": {{db_user_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Current shift",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns the open shift', () => pm.expect(pm.response.json().data.endTime).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/shifts/current?userId={{db_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["shifts", "current"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{db_user_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "List shifts - today",
