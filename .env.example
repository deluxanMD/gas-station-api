# ─────────────────────────────────────────
# Gas Station Portal API — Environment Reference
# Copy this file to .env.development or .env.production
# NEVER commit actual .env files to version control
# ─────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1

# CORS — comma-separated origins or * for all
CORS_ORIGIN=http://localhost:3000

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gas_station_db

# Authentication — must be at least 32 characters in production
JWT_SECRET=change-me-to-a-secure-random-32-char-minimum-key
JWT_EXPIRES_IN=7d
